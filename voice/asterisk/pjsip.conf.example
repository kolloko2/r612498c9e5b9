[transport-udp]
type=transport
protocol=udp
bind=${ASTERISK_SIP_BIND}:5060

[201]
type=endpoint
transport=transport-udp
context=training-only
disallow=all
allow=ulaw,alaw
auth=auth201
aors=201
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth201]
type=auth
auth_type=userpass
username=201
password=${SIP201_PASSWORD}

[201]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30
