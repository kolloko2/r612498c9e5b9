# Default: no physical calls, no external speech API, media spike only.
# Warm Silero pool: 1-4 processes, 1-8 CPU threads per process.
TTS_WORKERS=2
TTS_THREADS_PER_WORKER=2
TELEPHONY_MODE=mock
PIPELINE_MODE=spike
TOPOLOGY_VERIFIED=false
TOPOLOGY_PROBE_EXTENSION=
BACKEND_MODE=mock
BACKEND_URL=ws://backend:8000/ws/v1/voice/sessions/{session_id}
BACKEND_TOKEN=
BACKEND_RETRIES=4
BACKEND_BACKOFF_S=0.5
BACKEND_RECONNECT_BUDGET_S=30

API_TOKEN=
ARI_URL=http://asterisk:8088/ari
ARI_USERNAME=voice
ARI_PASSWORD=
ARI_APP=voice-gateway
MEDIA_CONNECTION=voice-media
MEDIA_USERNAME=asterisk
MEDIA_PASSWORD=
ALLOWED_EXTENSIONS=201
CONNECT_TIMEOUT_S=40
MAX_CALL_S=1800
MAX_CALLS=8
RECORDING_DIR=recordings
OUTBOX_DIR=outbox
SECURITY_AUDIT_DIR=

STT_PROVIDER=mock
STT_FALLBACK_PROVIDER=
STT_API_KEY=
# For Vosk: path to an unpacked Russian model directory.
STT_MODEL=
# Optional accurate final model used when STT_PROVIDER=hybrid.
STT_FINAL_MODEL=
STT_LANGUAGE=ru
TTS_PROVIDER=mock
TTS_FALLBACK_PROVIDER=
TTS_FALLBACK_VOICE=
TTS_SPEAKER=baya
TTS_API_KEY=
# For Piper: path to .onnx, with matching .onnx.json beside it.
TTS_VOICE=
PROVIDER_TIMEOUT_S=20
VAD_THRESHOLD=0.018
VAD_START_MS=40
VAD_END_MS=600
PREROLL_MS=500
UTTERANCE_LIMIT_S=30
ECHO_GUARD_MS=600

# Used by tools/render_asterisk_config.py, not directly by Asterisk.
SIP201_PASSWORD=
ASTERISK_HTTP_BIND=127.0.0.1
ASTERISK_SIP_BIND=0.0.0.0
VOICE_MEDIA_URL=ws://voice:8001/media
# For Docker publishing; use the host's specific private IP for a remote PBX.
VOICE_BIND_ADDRESS=127.0.0.1
